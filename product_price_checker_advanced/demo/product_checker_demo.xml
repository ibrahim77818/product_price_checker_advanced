<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Demo data: a retail scenario with variant products (colour x size),
        three warehouses with shelves, two extra pricelists and a ready-to-use
        kiosk. Variant-level data (codes, barcodes, images, stock, translations)
        is set by ``product.checker.config._ppc_demo_setup`` because variants
        are generated by the ORM and have no XML ids.
    -->

    <!-- Attributes ======================================================= -->
    <record id="demo_attr_color" model="product.attribute">
        <field name="name">Colour</field>
        <field name="display_type">color</field>
        <field name="create_variant">always</field>
        <field name="sequence">1</field>
    </record>
    <record id="demo_attr_color_red" model="product.attribute.value">
        <field name="name">Red</field>
        <field name="attribute_id" ref="demo_attr_color"/>
        <field name="html_color">#E53935</field>
        <field name="sequence">1</field>
    </record>
    <record id="demo_attr_color_blue" model="product.attribute.value">
        <field name="name">Blue</field>
        <field name="attribute_id" ref="demo_attr_color"/>
        <field name="html_color">#1E88E5</field>
        <field name="sequence">2</field>
    </record>
    <record id="demo_attr_color_black" model="product.attribute.value">
        <field name="name">Black</field>
        <field name="attribute_id" ref="demo_attr_color"/>
        <field name="html_color">#263238</field>
        <field name="sequence">3</field>
    </record>
    <record id="demo_attr_color_white" model="product.attribute.value">
        <field name="name">White</field>
        <field name="attribute_id" ref="demo_attr_color"/>
        <field name="html_color">#FAFAFA</field>
        <field name="sequence">4</field>
    </record>

    <record id="demo_attr_size" model="product.attribute">
        <field name="name">Size</field>
        <field name="display_type">pills</field>
        <field name="create_variant">always</field>
        <field name="sequence">2</field>
    </record>
    <record id="demo_attr_size_s" model="product.attribute.value">
        <field name="name">S</field>
        <field name="attribute_id" ref="demo_attr_size"/>
        <field name="sequence">1</field>
    </record>
    <record id="demo_attr_size_m" model="product.attribute.value">
        <field name="name">M</field>
        <field name="attribute_id" ref="demo_attr_size"/>
        <field name="sequence">2</field>
    </record>
    <record id="demo_attr_size_l" model="product.attribute.value">
        <field name="name">L</field>
        <field name="attribute_id" ref="demo_attr_size"/>
        <field name="sequence">3</field>
    </record>

    <record id="demo_attr_shoe" model="product.attribute">
        <field name="name">Shoe Size</field>
        <field name="display_type">pills</field>
        <field name="create_variant">always</field>
        <field name="sequence">3</field>
    </record>
    <record id="demo_attr_shoe_41" model="product.attribute.value">
        <field name="name">41</field>
        <field name="attribute_id" ref="demo_attr_shoe"/>
        <field name="sequence">1</field>
    </record>
    <record id="demo_attr_shoe_42" model="product.attribute.value">
        <field name="name">42</field>
        <field name="attribute_id" ref="demo_attr_shoe"/>
        <field name="sequence">2</field>
    </record>
    <record id="demo_attr_shoe_43" model="product.attribute.value">
        <field name="name">43</field>
        <field name="attribute_id" ref="demo_attr_shoe"/>
        <field name="sequence">3</field>
    </record>

    <!-- "Never" attribute: a sale-time option, must NOT appear in the matrix. -->
    <record id="demo_attr_giftwrap" model="product.attribute">
        <field name="name">Gift Wrap</field>
        <field name="display_type">radio</field>
        <field name="create_variant">no_variant</field>
        <field name="sequence">9</field>
    </record>
    <record id="demo_attr_giftwrap_yes" model="product.attribute.value">
        <field name="name">Gift wrapped</field>
        <field name="attribute_id" ref="demo_attr_giftwrap"/>
    </record>
    <record id="demo_attr_giftwrap_no" model="product.attribute.value">
        <field name="name">No wrapping</field>
        <field name="attribute_id" ref="demo_attr_giftwrap"/>
    </record>

    <!-- Products ========================================================= -->
    <record id="demo_categ_apparel" model="product.category">
        <field name="name">Apparel</field>
        <field name="parent_id" ref="product.product_category_all"/>
    </record>

    <record id="demo_tmpl_tshirt" model="product.template">
        <field name="name">Classic Cotton T-Shirt</field>
        <field name="detailed_type">product</field>
        <field name="categ_id" ref="demo_categ_apparel"/>
        <field name="list_price">49.0</field>
        <field name="standard_price">18.0</field>
        <field name="description_sale">100% combed cotton, regular fit, 180 g/m². Machine washable at 30°C.</field>
        <field name="image_1920" type="base64" file="product_price_checker_advanced/static/img/demo/tshirt_red.png"/>
    </record>
    <record id="demo_tmpl_tshirt_line_color" model="product.template.attribute.line">
        <field name="product_tmpl_id" ref="demo_tmpl_tshirt"/>
        <field name="attribute_id" ref="demo_attr_color"/>
        <field name="value_ids" eval="[(6, 0, [ref('demo_attr_color_red'), ref('demo_attr_color_blue'), ref('demo_attr_color_black')])]"/>
    </record>
    <record id="demo_tmpl_tshirt_line_size" model="product.template.attribute.line">
        <field name="product_tmpl_id" ref="demo_tmpl_tshirt"/>
        <field name="attribute_id" ref="demo_attr_size"/>
        <field name="value_ids" eval="[(6, 0, [ref('demo_attr_size_s'), ref('demo_attr_size_m'), ref('demo_attr_size_l')])]"/>
    </record>
    <record id="demo_tmpl_tshirt_line_giftwrap" model="product.template.attribute.line">
        <field name="product_tmpl_id" ref="demo_tmpl_tshirt"/>
        <field name="attribute_id" ref="demo_attr_giftwrap"/>
        <field name="value_ids" eval="[(6, 0, [ref('demo_attr_giftwrap_yes'), ref('demo_attr_giftwrap_no')])]"/>
    </record>

    <record id="demo_tmpl_sneaker" model="product.template">
        <field name="name">Urban Runner Sneakers</field>
        <field name="detailed_type">product</field>
        <field name="categ_id" ref="demo_categ_apparel"/>
        <field name="list_price">289.0</field>
        <field name="standard_price">120.0</field>
        <field name="description_sale">Lightweight knit upper, cushioned EVA sole. Ideal for daily city walks.</field>
        <field name="image_1920" type="base64" file="product_price_checker_advanced/static/img/demo/sneaker_black.png"/>
    </record>
    <record id="demo_tmpl_sneaker_line_color" model="product.template.attribute.line">
        <field name="product_tmpl_id" ref="demo_tmpl_sneaker"/>
        <field name="attribute_id" ref="demo_attr_color"/>
        <field name="value_ids" eval="[(6, 0, [ref('demo_attr_color_black'), ref('demo_attr_color_white'), ref('demo_attr_color_red')])]"/>
    </record>
    <record id="demo_tmpl_sneaker_line_size" model="product.template.attribute.line">
        <field name="product_tmpl_id" ref="demo_tmpl_sneaker"/>
        <field name="attribute_id" ref="demo_attr_shoe"/>
        <field name="value_ids" eval="[(6, 0, [ref('demo_attr_shoe_41'), ref('demo_attr_shoe_42'), ref('demo_attr_shoe_43')])]"/>
    </record>

    <record id="demo_product_bottle" model="product.product">
        <field name="name">Stainless Water Bottle 750 ml</field>
        <field name="detailed_type">product</field>
        <field name="list_price">65.0</field>
        <field name="default_code">BTL-750</field>
        <field name="barcode">6281000000014</field>
        <field name="description_sale">Double-wall insulated: 24 h cold, 12 h hot. BPA free.</field>
        <field name="image_1920" type="base64" file="product_price_checker_advanced/static/img/demo/bottle.png"/>
    </record>
    <record id="demo_product_earbuds" model="product.product">
        <field name="name">Wireless Earbuds Pro</field>
        <field name="detailed_type">product</field>
        <field name="list_price">399.0</field>
        <field name="default_code">EAR-PRO</field>
        <field name="barcode">6281000000021</field>
        <field name="description_sale">Active noise cancelling, 30 h battery with the charging case.</field>
        <field name="image_1920" type="base64" file="product_price_checker_advanced/static/img/demo/earbuds.png"/>
    </record>
    <record id="demo_packaging_earbuds" model="product.packaging">
        <field name="name">Carton of 10</field>
        <field name="product_id" ref="demo_product_earbuds"/>
        <field name="qty">10</field>
        <field name="barcode">16281000000028</field>
    </record>
    <record id="demo_product_coffee" model="product.product">
        <field name="name">Organic Coffee Beans 1 kg</field>
        <field name="detailed_type">product</field>
        <field name="list_price">95.0</field>
        <field name="default_code">COF-1KG</field>
        <field name="barcode">6281000000038</field>
        <field name="description_sale">Single-origin arabica, medium roast.</field>
        <field name="image_1920" type="base64" file="product_price_checker_advanced/static/img/demo/coffee.png"/>
    </record>

    <!-- Warehouses ======================================================= -->
    <record id="demo_wh_downtown" model="stock.warehouse">
        <field name="name">Downtown Store</field>
        <field name="code">DTS</field>
        <field name="partner_id" ref="base.main_partner"/>
    </record>
    <record id="demo_wh_mall" model="stock.warehouse">
        <field name="name">North Mall Store</field>
        <field name="code">NMS</field>
        <field name="partner_id" ref="base.main_partner"/>
    </record>

    <!-- Pricelists ======================================================= -->
    <record id="demo_pricelist_vip" model="product.pricelist">
        <field name="name">VIP Members</field>
        <field name="sequence">20</field>
    </record>
    <record id="demo_pricelist_vip_item" model="product.pricelist.item">
        <field name="pricelist_id" ref="demo_pricelist_vip"/>
        <field name="applied_on">3_global</field>
        <field name="compute_price">percentage</field>
        <field name="percent_price">10</field>
    </record>
    <record id="demo_pricelist_vip_sneaker" model="product.pricelist.item">
        <field name="pricelist_id" ref="demo_pricelist_vip"/>
        <field name="applied_on">1_product</field>
        <field name="product_tmpl_id" ref="demo_tmpl_sneaker"/>
        <field name="compute_price">percentage</field>
        <field name="percent_price">20</field>
    </record>

    <!-- Kiosk ============================================================ -->
    <record id="demo_kiosk_main" model="product.checker.config">
        <field name="name">Main Store - Entrance</field>
        <field name="token">demo-price-checker-main-store-token-change-me</field>
        <field name="stock_display">location</field>
        <field name="stock_qty_mode">quantity</field>
        <field name="low_stock_threshold">5</field>
        <field name="primary_color">#714B67</field>
    </record>
    <record id="demo_kiosk_main_pl_public" model="product.checker.pricelist">
        <field name="config_id" ref="demo_kiosk_main"/>
        <field name="pricelist_id" ref="product.list0"/>
        <field name="label">Price</field>
        <field name="sequence">1</field>
    </record>
    <record id="demo_kiosk_main_pl_vip" model="product.checker.pricelist">
        <field name="config_id" ref="demo_kiosk_main"/>
        <field name="pricelist_id" ref="demo_pricelist_vip"/>
        <field name="label">VIP Members</field>
        <field name="sequence">2</field>
    </record>
    <record id="demo_kiosk_main_promo_season" model="product.checker.promo">
        <field name="config_id" ref="demo_kiosk_main"/>
        <field name="name">New season collection is here</field>
        <field name="image" type="base64" file="product_price_checker_advanced/static/img/demo/promo_season.png"/>
        <field name="sequence">1</field>
    </record>
    <record id="demo_kiosk_main_promo_members" model="product.checker.promo">
        <field name="config_id" ref="demo_kiosk_main"/>
        <field name="name">VIP members save 10% on everything</field>
        <field name="image" type="base64" file="product_price_checker_advanced/static/img/demo/promo_members.png"/>
        <field name="sequence">2</field>
    </record>

    <record id="demo_kiosk_warehouse" model="product.checker.config">
        <field name="name">Warehouse - Status Only</field>
        <field name="token">demo-price-checker-warehouse-token-change-me</field>
        <field name="stock_display">warehouse</field>
        <field name="stock_qty_mode">status</field>
        <field name="history_enabled" eval="False"/>
        <field name="primary_color">#00695C</field>
    </record>

    <!-- Variant data, stock, languages and translations. -->
    <function model="product.checker.config" name="_ppc_demo_setup"/>
</odoo>
